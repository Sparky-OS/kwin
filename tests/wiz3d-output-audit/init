#!/bin/busybox sh
# SPDX-License-Identifier: GPL-2.0-or-later
export PATH=/bin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t tmpfs tmpfs /run
mount -t tmpfs tmpfs /tmp
mount -t configfs configfs /sys/kernel/config
mount -t debugfs debugfs /sys/kernel/debug
exec 0</dev/console 1>/dev/console 2>&1
mkdir -p /work /r
mount -t 9p -o trans=virtio,version=9p2000.L work /work || poweroff -f
mount -t 9p -o trans=virtio,version=9p2000.L,ro root /r || poweroff -f
d=/sys/kernel/config/vkms/audit
mkdir "$d"
for i in 0 1; do
    mkdir "$d/planes/primary$i" "$d/planes/cursor$i" "$d/crtcs/crtc$i" "$d/encoders/encoder$i" "$d/connectors/hdmi$i"
    echo 1 > "$d/planes/primary$i/type"
    echo 2 > "$d/planes/cursor$i/type"
    for plane in primary cursor; do
        ln -s "$d/crtcs/crtc$i" "$d/planes/$plane$i/possible_crtcs/crtc$i"
    done
    ln -s "$d/crtcs/crtc$i" "$d/encoders/encoder$i/possible_crtcs/crtc$i"
    echo 11 > "$d/connectors/hdmi$i/type"
    cat /data/stereo-test.bin > "$d/connectors/hdmi$i/edid"
    echo 1 > "$d/connectors/hdmi$i/edid_enabled"
    ln -s "$d/encoders/encoder$i" "$d/connectors/hdmi$i/possible_encoders/encoder$i"
done
echo 1 > "$d/enabled"
mount -t proc proc /r/proc
mount -t sysfs sysfs /r/sys
mount -t devtmpfs devtmpfs /r/dev
mkdir -p /r/dev/pts /r/dev/shm
mount -t devpts devpts /r/dev/pts
mount -t tmpfs tmpfs /r/dev/shm
for d in /r/tmp /r/run /r/root /r/var/tmp; do mount -t tmpfs tmpfs "$d"; done
mkdir -p /r/tmp/work /tmp/kwin21
mount --bind /work /r/tmp/work
tar -xf /work/rig/scratch/kwin21.tar -C /tmp/kwin21
find /tmp/kwin21 -type f | while read -r f; do
    target=/r/${f#/tmp/kwin21/}
    if [ -f "$target" ]; then mount --bind "$f" "$target"; else echo "OVERRIDE_MISSING $target"; fi
done
cp /bin/drm-grab /r/tmp/drm-grab
chroot /r /bin/sh /tmp/work/rig/guest-session.sh
echo "AUDIT_GUEST_EXIT $?"
sync
poweroff -f
