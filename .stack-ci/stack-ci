#!/usr/bin/env python3
"""Our stack inside a pipeline job: the steps kde-ci-local and an invent pipeline both run.

    stack-ci prepare --use A,B [--exclude P] [--mode auto|build|fetch]
    stack-ci publish

prepare resolves the members' commits on the remote (git ls-remote), computes their keys
(kdecistack.key_of over the source id of the commit, so CI-only commits keep the key, with the job image's identity: a hash of its installed packages), and for every
member that is needed gets its prefix: downloaded from the registry when a package of that key
exists, else built from source with KDE's own run-ci-build.py through stack-run-ci-build.  The
members are then composed into one folder (STACK_CI_OUT), the KDE_CI_STACK_PREFIX of the job.
publish uploads the prefixes built in this job to the registry.

Environment:
  STACK_CI_GIT_BASE   where the members' repositories are (default https://invent.kde.org/danielcamposramos)
  STACK_CI_REGISTRY   generic package registry base (default: the registry-project of the stack file on
                      $CI_API_V4_URL); a package is NAME/MEMBER-KEY/prefix.tar.xz under it
  STACK_CI_WORK       work folder (default /tmp/stack-ci)
  STACK_CI_OUT        the composed prefix (default $STACK_CI_WORK/prefix)
  CI_JOB_TOKEN        needed by publish
"""
import argparse
import json
import os
import shutil
import subprocess
import sys
import tarfile
import time
import urllib.error
import urllib.parse
import urllib.request

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import kdecistack  # noqa: E402

WORK = os.environ.get("STACK_CI_WORK", "/tmp/stack-ci")
OUT = os.environ.get("STACK_CI_OUT", os.path.join(WORK, "prefix"))
BASE = os.environ.get("STACK_CI_GIT_BASE", "https://invent.kde.org/danielcamposramos")


def say(msg):
    print(f"## STACK-CI: {msg}", flush=True)


def image_identity():
    try:
        out = subprocess.run("rpm -qa --qf '%{NAME}-%{VERSION}-%{RELEASE}\\n' | sort | sha1sum", shell=True,
                             capture_output=True, text=True, check=True).stdout
        return out.split()[0][:12]
    except Exception:
        return "unknown"


def registry(stack):
    if os.environ.get("STACK_CI_REGISTRY"):
        return os.environ["STACK_CI_REGISTRY"].rstrip("/")
    api = os.environ.get("CI_API_V4_URL", "https://invent.kde.org/api/v4")
    proj = urllib.parse.quote(stack["registry-project"], safe="")
    return f"{api}/projects/{proj}/packages/generic/{stack['name']}"


def url_of(m):
    return f"{BASE}/{m['repo']}.git"


def resolve(stack, image):
    members = {}
    for name in stack["order"]:
        m = dict(stack["members"][name])
        m.update(name=name, package=name)
        ref = "refs/heads/" + m["ci-name"]
        out = subprocess.check_output(["git", "ls-remote", url_of(m), ref], text=True).split()
        if not out:
            sys.exit(f"STATUS: blocked - {url_of(m)} has no branch {m['ci-name']}")
        m["commit"], m["branch"] = out[0], m["ci-name"]
        m["source"] = remote_source_id(m)
        m["key"] = kdecistack.key_of(name, m["source"], image, {d: members[d]["key"] for d in m.get("needs", [])})
        members[name] = m
    return members


def remote_source_id(m):
    """kdecistack.source_id of the commit on the remote: fetches its trees, no file contents."""
    probe = os.path.join(WORK, "probe", m["name"])
    shutil.rmtree(probe, ignore_errors=True)
    os.makedirs(probe)
    subprocess.check_call(["git", "init", "-q", "--bare"], cwd=probe)
    subprocess.check_call(["git", "fetch", "-q", "--depth", "1", "--filter=blob:none", url_of(m), m["commit"]], cwd=probe)
    sid = kdecistack.source_id(probe, m["commit"])
    shutil.rmtree(probe, ignore_errors=True)
    return sid


def mdir(m):
    return os.path.join(WORK, "members", f"{m['name']}-{m['key']}")


def compose(stack, members, names, dest):
    chosen = {n: members[n] for n in stack["order"] if n in names}
    shutil.rmtree(dest, ignore_errors=True)
    files = os.path.join(dest, "files")
    os.makedirs(files)
    for n, m in chosen.items():
        src = os.path.join(mdir(m), "prefix")
        for root, dirs, fs in os.walk(src):
            rel = os.path.relpath(root, src)
            out = files if rel == "." else os.path.join(files, rel)
            os.makedirs(out, exist_ok=True)
            for f in fs:
                s, d = os.path.join(root, f), os.path.join(out, f)
                if os.path.lexists(d):
                    os.remove(d)
                if os.path.islink(s):
                    os.symlink(os.readlink(s), d)
                else:
                    os.link(s, d)
    key = kdecistack.key_of("compose", "", "", {n: m["key"] for n, m in chosen.items()})
    with open(os.path.join(dest, "stack.json"), "w") as f:
        json.dump({"stack": stack["name"], "key": key,
                   "members": {n: {k: m[k] for k in ("package", "branch", "commit", "key")} for n, m in chosen.items()}}, f, indent=1)
    return key


def fetch(stack, m):
    url = f"{registry(stack)}/{m['name']}-{m['key']}/prefix.tar.xz"
    tmp = os.path.join(WORK, f"{m['name']}-{m['key']}.tar.xz")
    os.makedirs(WORK, exist_ok=True)
    try:
        with urllib.request.urlopen(url, timeout=120) as r, open(tmp, "wb") as f:
            shutil.copyfileobj(r, f)
    except urllib.error.HTTPError as e:
        if e.code in (404, 403):
            return None
        raise
    except urllib.error.URLError as e:
        say(f"registry not reachable ({e.reason}); building {m['name']}")
        return None
    size = os.path.getsize(tmp)
    dest = mdir(m)
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest)
    with tarfile.open(tmp) as t:
        t.extractall(os.path.join(dest, "prefix"), filter="fully_trusted")
    os.remove(tmp)
    return size


def build(stack, members, m, ci_utils):
    name = m["name"]
    src = os.path.join(WORK, "src", name)
    shutil.rmtree(src, ignore_errors=True)
    os.makedirs(src)
    for cmd in (["git", "init", "-q", "-b", "stack-ci-unborn"],
                ["git", "remote", "add", "origin", url_of(m)],
                ["git", "fetch", "-q", "--depth", "1", "origin", m["commit"]],
                ["git", "checkout", "-q", "--detach", "FETCH_HEAD"],
                ["git", "branch", "-q", "-f", m["ci-name"], "FETCH_HEAD"]):
        subprocess.check_call(cmd, cwd=src)
    needs = kdecistack.closure(members, name) - {name}
    env = dict(os.environ, CI_REPOSITORY_URL=url_of(m), CI_PROJECT_NAME=name, CI_COMMIT_REF_NAME=m["ci-name"])
    cmd = [sys.executable, "-u"]
    if needs:
        pre = os.path.join(WORK, "compose-" + name)
        compose(stack, members, needs, pre)
        env["KDE_CI_STACK_PREFIX"] = pre
        cmd += [os.path.join(HERE, "stack-run-ci-build")]
    cmd += [os.path.join(ci_utils, "run-ci-build.py"), "--project", name, "--branch", m["ci-name"],
            "--platform", stack.get("platform-flavor", "Linux/Qt6/Shared"),
            "--extra-cmake-args=-DBUILD_WITH_QT6=ON", "--extra-cmake-args=-DQT_MAJOR_VERSION=6", "--only-build"]
    say(f"building {name} {m['commit'][:10]} (key {m['key']})")
    subprocess.check_call(cmd, cwd=src, env=env)
    staged = os.path.join(src, "_staging", os.path.join(src, "_install").lstrip("/"))
    dest = mdir(m)
    shutil.rmtree(dest, ignore_errors=True)
    os.makedirs(dest)
    shutil.copytree(staged, os.path.join(dest, "prefix"), symlinks=True)
    with open(os.path.join(dest, "built"), "w") as f:
        f.write(m["commit"] + "\n")
    shutil.rmtree(src, ignore_errors=True)


def prepare(args):
    import yaml
    with open(args.stack) as f:
        stack = yaml.safe_load(f)
    stack["order"] = kdecistack.load(args.stack)["order"]
    t0 = time.time()
    image = image_identity()
    members = resolve(stack, image)
    use = set(stack["order"]) if args.use == "all" else set(args.use.split(","))
    exclude = set()
    if args.exclude and args.exclude in members:
        exclude = {args.exclude} | kdecistack.dependents(members, args.exclude)
    needed = set()
    for n in use:
        needed |= kdecistack.closure(members, n)
    needed -= exclude
    ci_utils = os.path.abspath(args.ci_utilities)
    say(f"image {image}; " + ", ".join(f"{n} {members[n]['commit'][:10]} key {members[n]['key']}" for n in stack["order"] if n in needed))
    timings = {"image": image, "members": {}}
    for n in stack["order"]:
        if n not in needed:
            continue
        m = members[n]
        t = time.time()
        if os.path.exists(os.path.join(mdir(m), "prefix")):
            how, size = "present", None
        else:
            size = fetch(stack, m) if args.mode in ("auto", "fetch") else None
            how = "fetched" if size else None
            if not how:
                if args.mode == "fetch":
                    sys.exit(f"STATUS: blocked - no published package for {n} {m['key']}")
                build(stack, members, m, ci_utils)
                how = "built"
        timings["members"][n] = {"how": how, "seconds": round(time.time() - t, 1), "bytes": size, "key": m["key"]}
        say(f"{n}: {how} in {timings['members'][n]['seconds']}s" + (f" ({size / 2**20:.1f} MiB downloaded)" if size else ""))
    key = compose(stack, members, needed, OUT)
    timings["compose"] = key
    timings["total_seconds"] = round(time.time() - t0, 1)
    with open(os.path.join(OUT, "timings.json"), "w") as f:
        json.dump(timings, f, indent=1)
    say(f"stack {key} composed in {OUT}; prepare took {timings['total_seconds']}s")


def publish(args):
    import yaml
    with open(args.stack) as f:
        stack = yaml.safe_load(f)
    token = os.environ.get("CI_JOB_TOKEN")
    if not token:
        sys.exit("publish needs CI_JOB_TOKEN")
    mdirs = os.path.join(WORK, "members")
    for e in sorted(os.listdir(mdirs)) if os.path.isdir(mdirs) else []:
        d = os.path.join(mdirs, e)
        if not os.path.exists(os.path.join(d, "built")):
            continue
        tar = os.path.join(WORK, e + ".tar.xz")
        t = time.time()
        with tarfile.open(tar, "w:xz", preset=6) as tf:
            for item in sorted(os.listdir(os.path.join(d, "prefix"))):
                tf.add(os.path.join(d, "prefix", item), arcname=item)
        packed = time.time() - t
        req = urllib.request.Request(f"{registry(stack)}/{e}/prefix.tar.xz", data=open(tar, "rb").read(), method="PUT",
                                     headers={"JOB-TOKEN": token})
        t = time.time()
        urllib.request.urlopen(req, timeout=600).read()
        say(f"published {e}: {os.path.getsize(tar) / 2**20:.1f} MiB (packed {packed:.0f}s, uploaded {time.time() - t:.0f}s)")
        os.remove(tar)


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    p = sub.add_parser("prepare")
    p.add_argument("--stack", default=os.path.join(HERE, "stack.yml"))
    p.add_argument("--use", required=True, help="members the project needs (or all); what they need comes with them")
    p.add_argument("--exclude", help="the project built here, when it is a member")
    p.add_argument("--mode", default="auto", choices=["auto", "build", "fetch"])
    p.add_argument("--ci-utilities", default="ci-utilities")
    p.set_defaults(fn=prepare)
    p = sub.add_parser("publish")
    p.add_argument("--stack", default=os.path.join(HERE, "stack.yml"))
    p.set_defaults(fn=publish)
    a = ap.parse_args()
    a.fn(a)


if __name__ == "__main__":
    main()
